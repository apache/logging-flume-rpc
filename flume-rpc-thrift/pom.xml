<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.flume</groupId>
    <artifactId>flume-rpc</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>flume-rpc-thrift</artifactId>
  <name>Flume RPC Thrift</name>

  <properties>
    <module.name>org.apache.flume.rpc.thrift</module.name>
    <spotbugs.maxAllowedViolations>23</spotbugs.maxAllowedViolations>
    <pmd.maxAllowedViolations>4</pmd.maxAllowedViolations>
    <!-- Only used by the `compileThrift` profile -->
    <rewrite-maven-plugin.version>6.46.1</rewrite-maven-plugin.version>
    <rewrite-logging-frameworks.version>3.32.0</rewrite-logging-frameworks.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.flume</groupId>
      <artifactId>flume-ng-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.flume</groupId>
      <artifactId>flume-ng-sdk-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flume</groupId>
      <artifactId>flume-ng-auth</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.flume</groupId>
      <artifactId>flume-ng-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.thrift</groupId>
      <artifactId>libthrift</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <configuration>
          <!-- Generated by the Thrift compiler, see the `compileThrift` profile -->
          <excludes>
            <exclude>org/apache/flume/rpc/thrift/Status.java</exclude>
            <exclude>org/apache/flume/rpc/thrift/ThriftFlumeEvent.java</exclude>
            <exclude>org/apache/flume/rpc/thrift/ThriftSourceProtocol.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>compileThrift</id>
      <activation>
        <activeByDefault>false</activeByDefault>
      </activation>
      <dependencies>
        <!-- Lets OpenRewrite resolve the SLF4J types used by the freshly generated sources -->
        <dependency>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
          <scope>provided</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <!--
            ~ Downloads the Thrift source archive, verifies its checksum, builds the compiler and regenerates the sources.
            ~ Requires CMake, a C++ compiler, Bison and Flex.
            -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>compileThrift</id>
                <goals>
                  <goal>run</goal>
                </goals>
                <phase>generate-sources</phase>
                <configuration>
                  <target>
                    <property name="thrift.archive" value="${project.build.directory}/thrift-${thrift.version}.tar.gz" />
                    <property name="thrift.src" value="${project.build.directory}/thrift-${thrift.version}" />
                    <property name="thrift.build" value="${project.build.directory}/thrift-compiler" />
                    <property name="thrift.gen" value="${project.build.directory}/generated-sources/thrift" />
                    <get dest="${thrift.archive}" skipexisting="true" src="https://dlcdn.apache.org/thrift/${thrift.version}/thrift-${thrift.version}.tar.gz" />
                    <checksum algorithm="SHA-256" file="${thrift.archive}" property="${thrift.sha256}" verifyProperty="thrift.checksum.matches" />
                    <fail message="The checksum of ${thrift.archive} does not match `thrift.sha256`">
                      <condition>
                        <isfalse value="${thrift.checksum.matches}" />
                      </condition>
                    </fail>
                    <untar compression="gzip" dest="${project.build.directory}" overwrite="false" src="${thrift.archive}" />
                    <exec executable="cmake" failonerror="true">
                      <arg value="-S" />
                      <arg value="${thrift.src}" />
                      <arg value="-B" />
                      <arg value="${thrift.build}" />
                      <arg value="-DCMAKE_BUILD_TYPE=Release" />
                      <arg value="-DBUILD_COMPILER=ON" />
                      <arg value="-DBUILD_LIBRARIES=OFF" />
                      <arg value="-DBUILD_TESTING=OFF" />
                    </exec>
                    <exec executable="cmake" failonerror="true">
                      <arg value="--build" />
                      <arg value="${thrift.build}" />
                      <arg value="--parallel" />
                    </exec>
                    <delete dir="${thrift.gen}" />
                    <mkdir dir="${thrift.gen}" />
                    <apply executable="${thrift.build}/compiler/cpp/bin/thrift" failonerror="true">
                      <arg value="--gen" />
                      <arg value="java:generated_annotations=suppress" />
                      <arg value="-o" />
                      <arg value="${thrift.gen}" />
                      <fileset dir="src/main/thrift" includes="*.thrift" />
                    </apply>
                    <!-- Spotless adds the license header and formats the sources -->
                    <copy overwrite="true" todir="src/main/java/org/apache/flume/rpc/thrift">
                      <fileset dir="${thrift.gen}/gen-java/org/apache/flume/rpc/thrift" includes="*.java" />
                    </copy>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- The generated sources log through SLF4J and the Thrift compiler offers no option to change that: rewrite them to the Log4j API -->
          <plugin>
            <groupId>org.openrewrite.maven</groupId>
            <artifactId>rewrite-maven-plugin</artifactId>
            <version>${rewrite-maven-plugin.version}</version>
            <configuration>
              <activeRecipes>
                <recipe>org.openrewrite.java.logging.log4j.Slf4jToLog4j</recipe>
              </activeRecipes>
              <!-- Only rewrite the sources: the POM already depends on `log4j-api` -->
              <skipMavenParsing>true</skipMavenParsing>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>org.openrewrite.recipe</groupId>
                <artifactId>rewrite-logging-frameworks</artifactId>
                <version>${rewrite-logging-frameworks.version}</version>
              </dependency>
            </dependencies>
            <executions>
              <execution>
                <id>slf4j-to-log4j</id>
                <goals>
                  <!-- The freshly generated sources do not compile before the rewrite: do not fork the lifecycle -->
                  <goal>runNoFork</goal>
                </goals>
                <phase>process-sources</phase>
              </execution>
            </executions>
          </plugin>
          <!-- Format the generated and rewritten sources -->
          <plugin>
            <groupId>com.diffplug.spotless</groupId>
            <artifactId>spotless-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>format-thrift</id>
                <goals>
                  <goal>apply</goal>
                </goals>
                <phase>process-sources</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
